# Copy this file to .env and enter your Strava application credentials.
CLIENT_ID=your-strava-client-id
CLIENT_SECRET=your-strava-client-secret

# MongoDB connection and collections
MONGODB_URI=mongodb://localhost:27017/
MONGO_DB=sport_acties
MONGO_COLLECTION=acties
MONGO_COMMENTS_COLLECTION=comments
MONGO_ACTIVITIES_COLLECTION=activities

# Strava OAuth token endpoint
STRAVA_TOKEN_URL=https://www.strava.com/api/v3/oauth/token
